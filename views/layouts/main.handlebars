<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Gestor de Ideias</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="divHeader">
      <img src="images/logoInstituto.svg" alt="Logo Instituto">
      <div class="divUser">
        <p> {{user.username}}</p>
        <img src="images/person.svg" alt="person" id="person">
        <a href="/ideas/create" id="addIdea">
          <button>Adicionar Ideia</button>
        </a>
      </div>
    </div>
    <div class="divTitle">
      <h1>Gestor de Ideias</h1>
    </div>
  </header>

  <main>
    {{{body}}} 
  </main>
</body>
</html>
