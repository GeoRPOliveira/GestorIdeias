<div class="listIdeas">
  <div class="header">
    <h1>Ideias</h1>
    <a href="/ideas/create"><button>Criar nova ideia</button></a>
  </div>

  <ul class="ideasGrid">
    {{#each ideas}}
      <li class="idea">
        <strong>{{this.title}}</strong> - {{this.category}} <br>
        <p>{{this.description}}</p>
      </li>
    {{/each}}
  </ul>
</div>
