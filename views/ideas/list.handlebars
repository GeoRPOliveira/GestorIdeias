<div class="listIdeas">
  <ul class="ideasGrid">
    {{#each ideas}}
      <li class="ideaCard">
        <h3>{{this.title}}</h3>
        <hr />
        <p>{{this.description}}</p>
        <div class="info">
          <div class="vote">
            <img src="images/like.svg" alt="like">
            Gostei
            <img src="images/dislike.svg" alt="dislike">
            Não gostei  
          </div>
          <div class="category">
            {{this.category}}
          </div>
        </div>
      </li>
    {{/each}}
  </ul>
</div>
